# Copy this to .env (gitignored) and fill in real values.
# .env is read by `docker compose up -d` and by scripts/backup-headscale-key.sh.

# Absolute path to this `network/` directory on the host — used for every
# bind mount in docker-compose.yaml (./headscale/config.yaml, lib, run, etc).
WORK_DIR=/absolute/path/to/network

# Aiven Postgres password for the headscale database.
# Mapped by Viper to database.postgres.pass via HEADSCALE_DATABASE_POSTGRES_PASS
# in docker-compose.yaml — never put this in headscale/config.yaml directly.
HEADSCALE_DB_PASSWORD=

# Only needed to run scripts/backup-headscale-key.sh (backs up the noise
# private key to S3). Not required for `docker compose up -d` itself.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=krakens-bucket
S3_BACKUP_PREFIX=kwsbackup-headscale
